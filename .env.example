# 复制为 .env 后填写。真实 webhook/secret 绝不进 targets.yaml、绝不提交仓库。
#
# 通用设置（前缀 WEBMONITER_）
WEBMONITER_CONFIG_PATH=config/targets.yaml
WEBMONITER_DB_PATH=data/webmoniter.db
WEBMONITER_ARTIFACTS_DIR=data/artifacts
WEBMONITER_LOG_DIR=logs
WEBMONITER_LOG_LEVEL=INFO
WEBMONITER_TZ=Asia/Shanghai
WEBMONITER_RATE_PER_MINUTE=18
WEBMONITER_CONCURRENCY=5
WEBMONITER_DEFAULT_TIMEOUT=20
WEBMONITER_NOTIFY_RETRY_ATTEMPTS=3
WEBMONITER_HEALTH_INTERVAL=600
WEBMONITER_HEALTH_SILENCE_HOURS=6
# 自检告警发到哪些渠道（逗号分隔，渠道名如 feishu_ops）；留空=用全部已配置渠道
WEBMONITER_HEALTH_CHANNELS=

# 通知渠道：命名规则 <KIND>_WEBHOOK_<NAME>，渠道名 = <kind>_<name 小写>
#   FEISHU_WEBHOOK_OPS → 渠道 feishu_ops，targets.yaml 里写 channels: [feishu_ops]
# webhook 留空 = 该渠道未配置（`webmoniter channels` 会提示），请不要填示例 URL，
# 否则会被当成一个真实渠道，测试通知时报错难以定位。
# 飞书：https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx
FEISHU_WEBHOOK_OPS=
FEISHU_SECRET_OPS=
# 若飞书机器人安全设置选了「关键词」，在此填该关键词（会自动拼进标题）
FEISHU_KEYWORD_OPS=

# 钉钉：https://oapi.dingtalk.com/robot/send?access_token=xxxxxxxx
DINGTALK_WEBHOOK_OPS=
DINGTALK_SECRET_OPS=
DINGTALK_KEYWORD_OPS=

# 需要登录态的站点：把整条 Cookie 放环境变量，targets.yaml 里用 cookies_env 引用
# GOV_COOKIE=sessionid=xxx; token=yyy
